root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[*.[ch]]
indent_size = 2
indent_style = space
insert_final_newline = true
tab_width = 2

[meson.build]
indent_size = 2
indent_style = space
