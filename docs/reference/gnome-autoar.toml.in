[library]
description = "gnome-autoar provides functions for GNOME applications which want to use archives"
authors = "The GNOME Project"
license = "@license@"
version = "@version@"
browse_url = "https://gitlab.gnome.org/GNOME/gnome-autoar/"
repository_url = "https://gitlab.gnome.org/GNOME/gnome-autoar.git"
dependencies = [ "Gio-2.0", "GLib-2.0", "GObject-2.0" ]
website_url = "https://gnome.pages.gitlab.gnome.org/gnome-autoar/"
devhelp = true
search_index = true

  [dependencies."Gio-2.0"]
  name = "Gio"
  description = "GObject Interfaces and Objects, Networking, IPC, and I/O"
  docs_url = "https://docs.gtk.org/gio/"

  [dependencies."GLib-2.0"]
  name = "GLib"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/glib/"

  [dependencies."GObject-2.0"]
  name = "GObject"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gobject/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
# The base URL for the web UI
base_url = "https://gitlab.gnome.org/GNOME/gnome-autoar/-/blob/master/"
# The format for links, using "filename" and "line" for the format
file_format = "{filename}#L{line}"

[extra]
urlmap_file = "urlmap.js"
